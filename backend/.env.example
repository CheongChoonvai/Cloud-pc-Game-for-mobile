# --- Network ---
HOST=0.0.0.0
PORT=8000

# --- Video stream ---
TARGET_FPS=60
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_BITRATE=4000000
MONITOR_INDEX=1

# --- WebRTC ---
STUN_SERVER=stun://stun.l.google.com:19302

# --- Input ---
# auto = virtual Xbox controller if ViGEmBus available, otherwise keyboard
# keyboard = force keyboard fallback
INPUT_MODE=auto
MOUSE_SENSITIVITY=20

# --- GStreamer (Windows) ---
GSTREAMER_BIN=C:\Program Files\gstreamer\1.0\msvc_x86_64\bin
